# ---------------------------------------------------------------
# STM32CubeIDE build output. Fully regenerated from the sources and
# the .cproject, and about 55 MB - never commit it.
# ---------------------------------------------------------------
/Debug/
/Release/

# CubeMX writes this before regenerating code; not part of the project.
*.ioc.bak
*.bak

# ---------------------------------------------------------------
# Python host tools
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# Captures and exports produced by rr2_decode.py / rr2_gui.py
*.csv
*.xlsx
*.bin
/python/screenshots/

# Saved measurements. Bench data, not source: a thermal sweep is a few
# hundred of these, they belong wherever the analysis lives, and a
# repository of firmware is not it.
/python/measurements/

# The handful of choices the GUI remembers between runs.
/python/gui_prefs.json

# ---------------------------------------------------------------
# STM32CubeIDE per-workspace state. language.settings.xml carries an
# env-hash that changes whenever the toolchain environment shifts, so
# it turns up modified on its own and gets committed by accident; the
# other two are a favourites list and a pair of opaque hashes. None of
# it describes the project.
#
# The contents are ignored rather than the directory, because git will
# not descend into an ignored directory and the one file worth keeping
# lives inside it: encoding/<project>=UTF-8 is a real project setting,
# it never churns, and without it a fresh clone opens the sources in
# whatever codepage the machine defaults to.
# ---------------------------------------------------------------
/.settings/*
!/.settings/org.eclipse.core.resources.prefs

# ---------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
